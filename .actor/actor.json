{
  "actorSpecification": 1,
  "name": "feed-reader",
  "title": "RSS & Atom Feed Reader \u2014 Clean JSON for AI Pipelines",
  "description": "Pull any RSS/Atom/JSON feed into clean structured JSON. Date-window filters, item limits, full-text option. Per-result pricing \u2014 pay only for items returned.",
  "version": "0.1",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-empty"
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Feed items",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "feedUrl",
              "title",
              "link",
              "publishedAt"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "feedUrl": {
                "label": "Feed"
              },
              "title": {
                "label": "Title"
              },
              "link": {
                "label": "Link"
              },
              "publishedAt": {
                "label": "Published"
              }
            }
          }
        }
      }
    }
  }
}