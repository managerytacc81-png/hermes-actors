{
  "actorOutputSchemaVersion": 1,
  "title": "Output of RSS & Atom Feed Reader",
  "description": "Normalized feed items in the default dataset.",
  "properties": {
    "records": {
      "title": "Feed items",
      "description": "Clean normalized items from all feeds.",
      "template": "{{ links.apiDefaultDatasetUrl }}/items?offset=0&limit=1000&clean=true",
      "schema": {
        "type": "object",
        "properties": {
          "feedUrl": {
            "type": "string",
            "title": "Source feed URL"
          },
          "title": {
            "type": "string",
            "title": "Item title"
          },
          "link": {
            "type": "string",
            "title": "Item URL"
          },
          "guid": {
            "type": "string",
            "title": "Stable item ID"
          },
          "publishedAt": {
            "type": "string",
            "title": "Published (ISO 8601)"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "categories": {
            "type": "array",
            "title": "Categories",
            "items": {
              "type": "string"
            }
          },
          "contentText": {
            "type": "string",
            "title": "Cleaned full text (if requested)"
          },
          "contentHtml": {
            "type": "string",
            "title": "Full HTML (if requested)"
          }
        }
      },
      "type": "object"
    },
    "overview": {
      "title": "Overview table",
      "template": "{{ links.apiDefaultDatasetUrl }}/items?view=overview",
      "schema": {
        "type": "object"
      },
      "type": "object"
    }
  }
}